#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start the addon service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

# Declare variables
declare client_token

## Get the user config options.
client_token=$(bashio::config 'token')

## Pass the token via the environment so it does not appear on the command line.
export TUNNEL_TOKEN="${client_token}"

bashio::log.info "$(cloudflared --version)"
bashio::log.info "Starting the cloudflare tunnel daemon..."

exec cloudflared tunnel \
    --no-autoupdate \
    --edge-ip-version 4 \
    --retries 7 \
    --config "/etc/cloudflared/cloudflared.yaml" \
    run